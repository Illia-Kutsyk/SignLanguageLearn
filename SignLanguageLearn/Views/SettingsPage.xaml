<Page x:Class="SignLanguageLearn.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings" Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="40">
        <StackPanel MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="Налаштування" FontSize="32" FontWeight="Bold" 
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,30"/>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.05" ShadowDepth="2"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Вибір мови" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Мова жестів та інтерфейсу" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#15000000" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbUa" Content="UA" Style="{StaticResource LanguageToggleStyle}" GroupName="Langs" Checked="Difficulty_Changed"/>
                                <RadioButton x:Name="RbEn" Content="EN" Style="{StaticResource LanguageToggleStyle}" GroupName="Langs" Checked="Difficulty_Changed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Opacity="0.1" Margin="0,10,0,20" Background="{DynamicResource TextBrush}"/>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Візуальна тема" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Світла або темна тема" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#15000000" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbLight" Content="Light" Style="{StaticResource LanguageToggleStyle}" GroupName="Theme" Checked="Difficulty_Changed"/>
                                <RadioButton x:Name="RbDark" Content="Dark" Style="{StaticResource LanguageToggleStyle}" GroupName="Theme" Checked="Difficulty_Changed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Opacity="0.1" Margin="0,10,0,20" Background="{DynamicResource TextBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Складність тестів" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Easy (50%), Normal (75%), Hardcore (100%)" 
                   FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextBrush}" 
                   TextWrapping="Wrap" MaxWidth="300"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#15000000" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbEasy" Content="Easy" Style="{StaticResource LanguageToggleStyle}" 
                         GroupName="Diff" Checked="Difficulty_Changed"/>
                                <RadioButton x:Name="RbNormal" Content="Normal" Style="{StaticResource LanguageToggleStyle}" 
                         GroupName="Diff" Checked="Difficulty_Changed"/>
                                <RadioButton x:Name="RbHardcore" Content="Hardcore" Style="{StaticResource LanguageToggleStyle}" 
                         GroupName="Diff" Checked="Difficulty_Changed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>