<Page x:Class="SignLanguageLearn.Views.TestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Тестування" Background="{DynamicResource BackgroundBrush}">

    <Page.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#455A64"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <ScrollViewer x:Name="TestMenu" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Оберіть тему тестування" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <UniformGrid Columns="2" Width="750">
                    <Button Click="SelectTheme_Click" Tag="Alphabet" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🔤" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Алфавіт" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNumbersTest" Click="SelectTheme_Click" Tag="Numbers" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🔢" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtNumbersTest" Text="Числа та Математика" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPropertiesTest" Click="SelectTheme_Click" Tag="Properties" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🎨" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPropertiesTest" Text="Кольори та Властивості" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPhrasesTest" Click="SelectTheme_Click" Tag="Phrases" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="💬" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPhrasesTest" Text="Базові фрази" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTimeTest" Click="SelectTheme_Click" Tag="Time" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="⏳" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTimeTest" Text="Час та Календар" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSocietyTest" Click="SelectTheme_Click" Tag="Society" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🌍" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtSocietyTest" Text="Люди та Суспільство" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEnvironmentTest" Click="SelectTheme_Click" Tag="Environment" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🏞️" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEnvironmentTest" Text="Навколишній світ" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnActionsTest" Click="SelectTheme_Click" Tag="Actions" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🏃" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtActionsTest" Text="Дії та Рух" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStatesTest" Click="SelectTheme_Click" Tag="States" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🧠" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatesTest" Text="Стани та Почуття" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnObjectsTest" Click="SelectTheme_Click" Tag="Objects" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="📦" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtObjectsTest" Text="Предмети та Побут" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNmtTest" Click="SelectTheme_Click" Tag="NMT" Margin="15" Height="150" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="🎓" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtNmtTest" Text="Комплексний тест (НМТ)" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="TestInterface" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,20">
                <Button Content="←" Click="BtnMainMenu_Click" Width="60" Height="40" Style="{StaticResource ModernButtonStyle}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="⏱ 00:00" FontSize="22" FontWeight="Bold" Foreground="#FF7675" Margin="0,0,20,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ScoreText" Text="0/10" FontSize="22" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="Black" CornerRadius="20" ClipToBounds="True">
                <MediaElement x:Name="TestVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="TestVideo_MediaEnded" Stretch="Uniform"/>
            </Border>

            <UniformGrid x:Name="AnswersGrid" Grid.Row="2" Columns="3" Height="80" Margin="0,30,0,0">
                <Button x:Name="Answer1" Click="Answer_Click" Margin="10,0" Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="Answer2" Click="Answer_Click" Margin="10,0" Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="Answer3" Click="Answer_Click" Margin="10,0" Style="{StaticResource ModernButtonStyle}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Page>