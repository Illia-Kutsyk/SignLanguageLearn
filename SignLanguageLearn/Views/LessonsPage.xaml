<Page x:Class="SignLanguageLearn.Views.LessonsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LessonsPage" Background="{DynamicResource BackgroundBrush}">

    <Page.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#455A64"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="ContentGrid" Margin="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid x:Name="CategoryMenu" Columns="2" VerticalAlignment="Top" Visibility="Visible">

                <Button Click="Category_Click" Tag="Alphabet" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🔤" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Алфавіт" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnNumbers" Click="Category_Click" Tag="Numbers" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🔢" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtNumbers" Text="Числа та Математика" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnProperties" Click="Category_Click" Tag="Properties" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🎨" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtProperties" Text="Кольори та Властивості" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnPhrases" Click="Category_Click" Tag="Phrases" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="💬" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtPhrases" Text="Базові фрази" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnTime" Click="Category_Click" Tag="Time" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="⏳" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtTime" Text="Час та Календар" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSociety" Click="Category_Click" Tag="Society" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🌍" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtSociety" Text="Люди та Суспільство" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnEnvironment" Click="Category_Click" Tag="Environment" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🏞️" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtEnvironment" Text="Навколишній світ" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnActions" Click="Category_Click" Tag="Actions" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🏃" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtActions" Text="Дії та Рух" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnStates" Click="Category_Click" Tag="States" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🧠" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtStates" Text="Стани та Почуття" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnObjects" Click="Category_Click" Tag="Objects" Margin="15" Height="180" Style="{StaticResource ModernButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtObjects" Text="Предмети та Побут" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </UniformGrid>
        </ScrollViewer>

        <Grid x:Name="LessonContent" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="← Назад" Click="BackToMenu_Click" Width="120" Height="40" 
                        Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <ListBox Grid.Row="1" x:Name="ItemsList" 
                         Background="{DynamicResource CardBrush}" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}" SelectionChanged="ItemsList_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="FontSize" Value="18"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <Grid Grid.Column="1" Margin="30,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="Black" CornerRadius="20" ClipToBounds="True">
                    <MediaElement x:Name="LessonVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" 
                                  Stretch="Uniform" MediaEnded="LessonVideo_MediaEnded"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="🐌" FontSize="25" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0"/>
                        <Slider x:Name="SpeedSlider" Width="200" Minimum="0.2" Maximum="1.0" Value="1.0" 
                                ValueChanged="SpeedSlider_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="0.1"/>
                        <TextBlock Text="🐇" FontSize="25" Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="↺" Width="60" Height="50" Margin="10,0" Click="Restart_Click" Style="{StaticResource ModernButtonStyle}"/>
                        <Button Content="▶" Width="80" Height="50" Margin="10,0" Click="Play_Click" Style="{StaticResource ModernButtonStyle}"/>
                        <Button Content="⏸" Width="80" Height="50" Margin="10,0" Click="Pause_Click" Style="{StaticResource ModernButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>