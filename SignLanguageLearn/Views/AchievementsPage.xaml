<Page x:Class="SignLanguageLearn.Views.AchievementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AchievementsPage" 
      Background="{DynamicResource BackgroundBrush}">

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ContentGrid" 
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.6"/>
                    <ThicknessAnimation Storyboard.TargetName="ContentGrid"
                                        Storyboard.TargetProperty="Margin"
                                        From="40,100,40,0" To="40,40,40,40" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid x:Name="ContentGrid" Margin="40">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🏆" FontSize="80" HorizontalAlignment="Center"/>
            <TextBlock Text="Досягнення" FontSize="32" FontWeight="Bold" 
                       Foreground="{DynamicResource TextBrush}" 
                       HorizontalAlignment="Center" Margin="0,20"/>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="15" Padding="25" Width="520">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>

                <StackPanel>
                    <CheckBox x:Name="Ach101" 
                              Content="🥇 Перший крок: Пройти тест по Алфавіту" 
                              IsChecked="False" IsEnabled="False" 
                              Foreground="{DynamicResource TextBrush}" Margin="0,8" FontSize="15"/>

                    <CheckBox x:Name="Ach102" 
                              Content="🧠 Перфекціоніст: Пройти всі тести окрім НМТ" 
                              IsChecked="False" IsEnabled="False" 
                              Foreground="{DynamicResource TextBrush}" Margin="0,8" FontSize="15"/>

                    <CheckBox x:Name="Ach103" 
                              Content="💀 Сталеві нерви: Будь-який тест на хардкорі" 
                              IsChecked="False" IsEnabled="False" 
                              Foreground="{DynamicResource TextBrush}" Margin="0,8" FontSize="15"/>

                    <CheckBox x:Name="Ach104" 
                              Content="🎓 Абітурієнт: Пройти комплексний тест (НМТ)" 
                              IsChecked="False" IsEnabled="False" 
                              Foreground="{DynamicResource TextBrush}" Margin="0,8" FontSize="15"/>

                    <CheckBox x:Name="Ach105" 
                              Content="🔥 Майстер Екстриму: Пройти НМТ на хардкорі" 
                              IsChecked="False" IsEnabled="False" 
                              Foreground="{DynamicResource TextBrush}" Margin="0,8" FontSize="15"/>

                    <CheckBox x:Name="Ach106" 
                              Content="⚡ Блискавичний Фініш: НМТ на хардкорі за &lt;10 хв" 
                              IsChecked="False" IsEnabled="False" 
                              Foreground="{DynamicResource TextBrush}" Margin="0,8" FontSize="15"/>

                    <Separator Margin="0,20" Background="{DynamicResource TextBrush}" Opacity="0.2"/>

                    <TextBlock Text="Загальний прогрес ачівок" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                    <ProgressBar x:Name="OverallProgress" Value="0" Height="15" 
                                 Foreground="#00B894" Background="#E0E0E0" Margin="0,0,0,5"/>

                    <TextBlock x:Name="ProgressText" 
                               Text="0%" FontSize="12" Foreground="Gray" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>